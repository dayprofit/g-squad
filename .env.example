# Neon Postgres connection string; server-only.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DERIV_TOKEN_ENCRYPTION_KEY=generate-a-base64-encoded-32-byte-key

# Deriv OAuth app configuration
NEXT_PUBLIC_DERIV_APP_ID=
NEXT_PUBLIC_DERIV_REDIRECT_URI=http://localhost:3000
NEXT_PUBLIC_DERIV_APP_NAME=G-squad
NEXT_PUBLIC_DERIV_OAUTH_SCOPES=trade
NEXT_PUBLIC_DERIV_ENV=production

# Ollama Cloud (keep the API key server-only; use the exact cloud model name).
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=